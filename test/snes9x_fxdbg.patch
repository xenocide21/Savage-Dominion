index 3091ab6..0e6a372 100644
--- a/fxemu.cpp
+++ b/fxemu.cpp
@@ -1,3 +1,5 @@
+#include <stdio.h>
+#include <string.h>
 /*****************************************************************************\
      Snes9x - Portable Super Nintendo Entertainment System (TM) emulator.
                 This file is licensed under the Snes9x License.
@@ -420,6 +422,29 @@ static bool8 fx_checkStartAddress (void)
 }
 
 // Execute until the next stop instruction
+static uint32 fxdbg_hist[65536];
+static unsigned long long fxdbg_insns;
+extern "C" unsigned long long fxdbg_count (void) { return fxdbg_insns; }
+extern "C" void fxdbg_dump (void)
+{
+	for (int n = 0; n < 400; n++)
+	{
+		int best = 0;
+		for (int i = 0; i < 65536; i++) if (fxdbg_hist[i] > fxdbg_hist[best]) best = i;
+		if (!fxdbg_hist[best]) break;
+		fprintf(stderr, "fxpc %04X %u\n", best, fxdbg_hist[best]);
+		fxdbg_hist[best] = 0;
+	}
+}
+extern "C" void fxdbg_regs (void)
+{
+	for (int i = 0; i < 16; i++) fprintf(stderr, "r%d=%04X ", i, GSU.avReg[i] & 0xFFFF);
+	fprintf(stderr, "\nram:");
+	for (int a = 0; a < 0x100; a += 2) fprintf(stderr, "%s%04X", (a & 31) ? " " : "\n  ", GSU.pvRam[a] | GSU.pvRam[a + 1] << 8);
+	fprintf(stderr, "\n");
+}
+extern "C" void fxdbg_clear (void) { memset(fxdbg_hist, 0, sizeof(fxdbg_hist)); fxdbg_insns = 0; }
+
 static uint32 FxEmulate (uint32 nInstructions)
 {
 	uint32	vCount;
@@ -449,6 +474,8 @@ static uint32 FxEmulate (uint32 nInstructions)
 	else
 	*/
 	vCount = fx_run(nInstructions);
+	fxdbg_hist[R15 & 0xFFFF]++;
+	fxdbg_insns += 1;   // one call per scanline slice while the GSU runs: busy time
 
 	// Store GSU registers
 	fx_writeRegisterSpace();
